#!/bin/bash

PID_FILE="./track/runpid.pid"

# Check if PID file exists
if [ ! -f "$PID_FILE" ]; then
  echo "No PID file found. Nothing to stop."
  exit 0
fi

# Iterate through each PID in the file and kill the process
while IFS= read -r pid; do
  if [[ -n "$pid" ]]; then
    if kill -9 "$pid" > /dev/null 2>&1; then
      echo "Killed process with PID $pid"
    else
      echo "Failed to kill process with PID $pid (it may not exist)"
    fi
  fi
done < "$PID_FILE"

# Remove the PID file
rm -f "$PID_FILE"
echo "Stopped and cleaned up."
