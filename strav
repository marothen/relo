#!/bin/bash -i

PID_FILE="./track/runpid.pid"
LOC_FILE="./track/location_latest.txt"

# Select directory under ./rou
echo "Select a directory under ./rou:"
dirs=$(find ./rou -mindepth 1 -maxdepth 1 -type d | sort)
i=1
for d in $dirs; do
  echo "  $i) $d"
  i=$((i+1))
done

printf "Enter number: "
read -r dir_choice

dir_count=$(echo "$dirs" | wc -l)
if ! echo "$dir_choice" | grep -Eq "^[0-9]+$" || [ "$dir_choice" -lt 1 ] || [ "$dir_choice" -gt "$dir_count" ]; then
  echo "Invalid directory selection."
  exit 1
fi

chosen_dir=$(echo "$dirs" | sed -n "${dir_choice}p")

# Select GPX file inside chosen directory
echo "Select a GPX file inside $chosen_dir:"
files=$(find "$chosen_dir" -maxdepth 1 -type f -name '*.gpx' | sort)
file_count=$(echo "$files" | wc -l)

if [ "$file_count" -eq 0 ]; then
  echo "No GPX files found in $chosen_dir."
  exit 1
fi

i=1
for f in $files; do
  echo "  $i) $(basename "$f")"
  i=$((i+1))
done

printf "Enter number: "
read -r file_choice

if ! echo "$file_choice" | grep -Eq "^[0-9]+$" || [ "$file_choice" -lt 1 ] || [ "$file_choice" -gt "$file_count" ]; then
  echo "Invalid file selection."
  exit 1
fi

chosen_file=$(echo "$files" | sed -n "${file_choice}p")

# Ask if user wants to define start lat/lon
printf "Do you want to define start latitude and longitude? (y/n): "
read -r define_loc

start_lat=""
start_lon=""

if [ "$define_loc" = "y" ] || [ "$define_loc" = "Y" ]; then
  if [ -f "$LOC_FILE" ]; then
    printf "Use saved location from $LOC_FILE? (y/n): "
    read -r use_saved

    if [ "$use_saved" = "y" ] || [ "$use_saved" = "Y" ]; then
      read -r start_lat start_lon < "$LOC_FILE"
      echo "Using saved location: lat=$start_lat, lon=$start_lon"
    else
      printf "Enter start latitude: "
      read -r start_lat
      printf "Enter start longitude: "
      read -r start_lon
    fi
  else
    printf "Enter start latitude: "
    read -r start_lat
    printf "Enter start longitude: "
    read -r start_lon
  fi
else
  # Explicitly clear variables
  start_lat=""
  start_lon=""
fi

# Ensure either both lat/lon are given or neither
if { [ -n "$start_lat" ] && [ -z "$start_lon" ]; } || \
   { [ -z "$start_lat" ] && [ -n "$start_lon" ]; }; then
  echo "Error: Either provide both latitude and longitude, or neither."
  exit 1
fi

# Validate format only if both are provided
if [ -n "$start_lat" ] && [ -n "$start_lon" ]; then
  if ! echo "$start_lat" | grep -Eq '^-?[0-9]+(\.[0-9]+)?$' || \
     ! echo "$start_lon" | grep -Eq '^-?[0-9]+(\.[0-9]+)?$'; then
    echo "Invalid latitude or longitude format. Must be decimal numbers."
    exit 1
  fi
fi

# Mandatory speed_kmh
printf "Enter speed_kmh (integer): "
read -r speed_kmh
if ! echo "$speed_kmh" | grep -Eq '^[0-9]+$'; then
  echo "speed_kmh must be an integer."
  exit 1
fi

# Mandatory interval_seconds
printf "Enter interval_seconds (integer): "
read -r interval_seconds
if ! echo "$interval_seconds" | grep -Eq '^[0-9]+$'; then
  echo "interval_seconds must be an integer."
  exit 1
fi


# Build command with optional lat/lon
cmd="./atrav.sh \"$chosen_file\" $speed_kmh $interval_seconds"
if [ -n "$start_lat" ] && [ -n "$start_lon" ]; then
  cmd="$cmd $start_lat $start_lon"
fi

# Ask the user if they want to enable debugging
read -rp "Do you want to enable debugging? (y/n): " enable_debug
if [[ "$enable_debug" =~ ^[Yy]$ ]]; then
  cmd="$cmd debug"
fi

# Step 5: Stop any existing processes
bash ./stop

echo "Running: $cmd"

# Start the atrav.sh script in background and disown
bash -c "$cmd & echo \$! > $PID_FILE; disown"

bash ./aseq.sh "$cmd" &
NEW_PID=$!
disown
echo "aseq.sh started in the background."

# Ensure the PID file exists
touch "$PID_FILE"

# Append the new PID as a new line to the PID file
echo "$NEW_PID" >> "$PID_FILE"

echo "Started atrav.sh with PID $(cat $PID_FILE)"
